
# UC Management System Environment Configuration

# Database Configuration
# For local development with PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/uc_management"

# For cloud deployment with Neon
# DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/uc_management?sslmode=require"

# For cloud deployment with Supabase
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# Admin Authentication
ADMIN_EMAIL="bikkuda@gmail.com"
ADMIN_PASSWORD="Noida@a07"

# Supabase Configuration (for cloud deployment)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# File Storage Configuration
# Set to 'local' for development, 'supabase' for production
STORAGE_TYPE="local"

# Local file storage path (relative to project root)
LOCAL_UPLOAD_PATH="./uploads"

# Application Configuration
NODE_ENV="development"
PORT="8080"

# Security
JWT_SECRET="your-jwt-secret-key-change-in-production"
SESSION_TIMEOUT="24h"

# Logging
LOG_LEVEL="info"

# File Upload Limits
MAX_FILE_SIZE="10MB"
ALLOWED_FILE_TYPES="pdf"

# Backup Configuration (optional)
BACKUP_ENABLED="false"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"
